// ---------------- FUNCOES ----------------

// Espera sem travar o servidor web
void esperar(unsigned long ms) {
  unsigned long ini = millis();
  while (millis() - ini < ms) {
    server.handleClient();
    delay(1);
  }
}

void bipe(int vezes, int duracao) {
  for (int i = 0; i < vezes; i++) {
    digitalWrite(PIN_BUZZER, HIGH);
    esperar(duracao);
    digitalWrite(PIN_BUZZER, LOW);
    esperar(duracao);
  }
}

void paginaInicial() {
  server.send_P(200, "text/html", PAGINA);
}

void enviarDados() {
  String json = "{";
  json += "\"temp\":" + String(erroSensor ? 0.0 : temperatura, 1) + ",";
  json += "\"umid\":" + String(erroSensor ? 0.0 : umidade, 1) + ",";
  json += "\"limite\":" + String(TEMP_LIMITE, 1) + ",";
  json += "\"alarme\":" + String(alarme ? "true" : "false") + ",";
  json += "\"erro\":" + String(erroSensor ? "true" : "false") + ",";
  json += "\"ip\":\"" + WiFi.localIP().toString() + "\",";
  json += "\"rssi\":" + String(WiFi.RSSI()) + ",";
  json += "\"uptime\":" + String(millis() / 1000);
  json += "}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

void lerSensor() {
  float u = dht.readHumidity();
  float t = dht.readTemperature();

  if (isnan(u) || isnan(t)) {
    erroSensor = true;
    alarme = false;
    Serial.println("Erro ao ler o DHT! Verifique a ligacao no D5.");
    digitalWrite(PIN_LED, HIGH);
    bipe(2, 80);
    digitalWrite(PIN_LED, LOW);
    return;
  }

  erroSensor = false;
  temperatura = t;
  umidade = u;
  alarme = (temperatura >= TEMP_LIMITE);

  Serial.printf("Temperatura: %.1f C | Umidade: %.1f %%\n", temperatura, umidade);

  if (alarme) {
    Serial.println("ALERTA: temperatura acima do limite!");
    digitalWrite(PIN_LED, HIGH);
    bipe(3, 200);
  } else {
    digitalWrite(PIN_LED, LOW);
    digitalWrite(PIN_BUZZER, LOW);
  }
}

// ---------------- SETUP / LOOP ----------------

void setup() {
  Serial.begin(115200);

  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);
  digitalWrite(PIN_LED, LOW);
  digitalWrite(PIN_BUZZER, LOW);

  dht.begin();

  // Conecta no Wi-Fi (LED pisca enquanto tenta)
  Serial.printf("Conectando em %s ", WIFI_SSID);
  WiFi.mode(WIFI_STA);
  if (strlen(WIFI_SENHA) == 0) {
    WiFi.begin(WIFI_SSID);               // rede aberta
  } else {
    WiFi.begin(WIFI_SSID, WIFI_SENHA);   // rede com senha
  }
  unsigned long ini = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - ini < 20000) {
    digitalWrite(PIN_LED, !digitalRead(PIN_LED));
    delay(300);
    Serial.print(".");
  }
  digitalWrite(PIN_LED, LOW);

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nConectado!");
    Serial.print("Abra no navegador: http://");
    Serial.println(WiFi.localIP());
    bipe(1, 150);
  } else {
    Serial.println("\nFalha no Wi-Fi. Verifique nome e senha.");
    bipe(3, 300);
  }

  server.on("/", paginaInicial);
  server.on("/dados", enviarDados);
  server.begin();
}

void loop() {
  server.handleClient();

  if (millis() - ultimaLeitura >= INTERVALO_LEITURA) {
    ultimaLeitura = millis();
    lerSensor();
  }
}