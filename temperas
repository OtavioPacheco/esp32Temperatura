// ESP32 + DHT + LED + Buzzer + Pagina Web
// Pinos: D2 = Buzzer | D4 = LED | D5 = DHT
// Bibliotecas: "DHT sensor library" (Adafruit) + "Adafruit Unified Sensor"
// Acesse pelo navegador o IP que aparece no Serial Monitor.

#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

// ====== CONFIGURE AQUI ======
const char* WIFI_SSID  = "Fatec";
const char* WIFI_SENHA = "";
// ============================

#define PIN_BUZZER 2   // D2
#define PIN_LED    4   // D4
#define PIN_DHT    5   // D5

#define DHTTYPE DHT11  // troque para DHT22 se for o caso

const float TEMP_LIMITE = 20.0;                    // graus Celsius
const unsigned long INTERVALO_LEITURA = 2000;      // ms

DHT dht(PIN_DHT, DHTTYPE);
WebServer server(80);

float temperatura = NAN;
float umidade = NAN;
bool alarme = false;
bool erroSensor = true;
unsigned long ultimaLeitura = 0;

