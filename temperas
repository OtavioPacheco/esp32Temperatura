const $ = id => document.getElementById(id);
const hT = [], hU = [], MAX = 40;

function fmtUptime(s){
  const h = Math.floor(s/3600), m = Math.floor((s%3600)/60);
  return h > 0 ? h + "h " + m + "min" : m + "min " + (s%60) + "s";
}

function desenhar(){
  const c = $("grafico"), r = window.devicePixelRatio || 1;
  c.width = c.clientWidth * r; c.height = c.clientHeight * r;
  const g = c.getContext("2d"); g.scale(r, r);
  const W = c.clientWidth, H = c.clientHeight, P = 12;
  g.clearRect(0, 0, W, H);

  g.strokeStyle = "rgba(255,255,255,.08)"; g.lineWidth = 1;
  for(let i = 0; i < 5; i++){
    const y = P + i * (H - 2*P) / 4;
    g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke();
  }

  function linha(dados, cor){
    if(dados.length < 2) return;
    let mn = Math.min(...dados), mx = Math.max(...dados);
    if(mx - mn < 2){ mn -= 1; mx += 1; }
    const pts = dados.map((v, i) => [
      i * W / (MAX - 1),
      H - P - (v - mn) / (mx - mn) * (H - 2*P)
    ]);
    const grad = g.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, cor + "55"); grad.addColorStop(1, cor + "00");
    g.beginPath(); g.moveTo(pts[0][0], H);
    pts.forEach(p => g.lineTo(p[0], p[1]));
    g.lineTo(pts[pts.length-1][0], H); g.closePath();
    g.fillStyle = grad; g.fill();
    g.beginPath();
    pts.forEach((p, i) => i ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1]));
    g.strokeStyle = cor; g.lineWidth = 2.5; g.lineJoin = "round"; g.stroke();
    const u = pts[pts.length-1];
    g.beginPath(); g.arc(u[0], u[1], 4, 0, 7); g.fillStyle = cor; g.fill();
  }
  linha(hT, "#fb923c");
  linha(hU, "#38bdf8");
}

